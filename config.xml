<?xml version='1.0' encoding='utf-8'?>
<widget id="id.ac.upitra.sarpras.inventaris" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Sistem Inventaris Sarpras</name>
    <description>Aplikasi Manajemen Inventaris Aset Kampus Universitas Pignatelli Triputra</description>
    <author email="sarpras@upitra.ac.id" href="https://upitra.ac.id">Biro Sarana dan Prasarana UPITRA</author>
    <content src="index.html" />
    <access origin="*" />
    <access origin="https://*.googleapis.com" />
    <access origin="https://*.cloudfunctions.net" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <platform name="android">
        <uses-permission android:name="android.permission.CAMERA" />
        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        <config-file parent="/*" target="app/src/main/AndroidManifest.xml">
            <uses-feature android:name="android.hardware.camera" android:required="false" />
        </config-file>
    </platform>
</widget>
